# wr-guides-api — variables de entorno
# LOCAL:    copiar este archivo a .env y completar los valores (NUNCA commitear .env).
# VERCEL:   Project → Settings → Environment Variables (mismos nombres, sin .env).
# Regla de oro: los secretos se generan en tu máquina y van directo acá o a Vercel.
#               NUNCA por chat, NUNCA en un commit, NUNCA en un comando que vayas a pegar.

# ── Supabase (Dashboard → Project Settings → API) ────────────────────────────
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SECRET key (sb_secret_…) — la publishable (sb_publishable_…) NO sirve: RLS la bloquea.
# /api/health detecta la publishable y responde 503 con la explicación.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_PEGA_AQUI_LA_SECRET_KEY

# ── Auth admin ────────────────────────────────────────────────────────────────
# Frase larga al azar. Generar en TU máquina:  openssl rand -hex 24
# Protege POST /api/guides (siembra/sync del catálogo).
ADMIN_TOKEN=

# ── CORS (orígenes permitidos, separados por coma) ────────────────────────────
ALLOWED_ORIGINS=https://wr-guides-web.vercel.app,http://localhost:3000

# ── Seed script (scripts/seed-guides.mjs) ─────────────────────────────────────
# URL base de la API, con / final. Local: http://localhost:3002/
# Producción: https://<tu-proyecto-api>.vercel.app/
WR_API=http://localhost:3002/
